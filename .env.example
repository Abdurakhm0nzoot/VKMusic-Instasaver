# === Telegram ===
BOT_TOKEN=your_telegram_bot_token_here

# === Music Search Sources ===
# 1. VK Music (Fastest). Requires VK API Token.
VK_TOKEN=your_vk_token_here

# 2. YouTube Music (Fallback). Handled automatically via yt-dlp.
# If you get rate-limited, you may provide a cookies.txt file path
# YOUTUBE_COOKIES_TXT=./cookies.txt

# === Database ===
# For local dev: sqlite+aiosqlite:///./bot.db
# For production: postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./bot.db

# === Redis (optional, falls back to MemoryStorage) ===
REDIS_URL=

# === Force Subscribe ===
# Channel username (with @) that users must subscribe to
FORCE_SUB_CHANNEL=

# === Admin ===
# Comma-separated Telegram user IDs
ADMIN_IDS=

# === Downloads ===
DOWNLOAD_DIR=./downloads
MAX_FREE_DOWNLOADS=20
